{
  "name": "crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TeamManager CRM — управление задачами команды",
  "workspaces": ["shared/contracts", "server", "client"],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": { "node": ">=20" }
}
