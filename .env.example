# Секрет для подписи сессий (сгенерировать: openssl rand -hex 32)
SESSION_SECRET=change-me-in-production
# Создавать демо-пользователей и задачи при первом запуске
SEED_DEMO=true
# Порт сервера
PORT=3001
# Куда сохранять БД и вложения
DATA_DIR=./data
UPLOADS_DIR=./uploads
# Лимит размера файла-вложения, МБ
MAX_UPLOAD_MB=10
